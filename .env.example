# ---------- Obligatorias ----------
# Clave de Google Gemini: https://aistudio.google.com/apikey (vacía = la app responde 503 "La IA no está configurada")
GEMINI_API_KEY=
# Conexión a PostgreSQL para correr sin Docker (con docker compose la define docker-compose.yml)
DATABASE_URL=postgresql://fiados:fiados@localhost:5433/fiados

# ---------- IA ----------
# gemini | falso (IA simulada, no gasta cuota)
PROVEEDOR_IA=gemini
MODEL_NAME=gemini-3.6-flash
# Esfuerzo de razonamiento del modelo: MINIMAL | LOW | MEDIUM | HIGH. LOW = menor latencia. Vacío = el del modelo.
THINKING_LEVEL=LOW

# ---------- Límites de la IA (ver README, sección 6) ----------
# Veces que se pide la lectura si la respuesta no cumple el formato
MAX_INTENTOS=3
# Tiempo máximo de CADA llamada a Gemini, en segundos
TIMEOUT_SEGUNDOS=30
# Tiempo máximo TOTAL de una foto (todos los reintentos y vueltas del agente), en segundos. 0 = sin tope
TIMEOUT_TOTAL_SEGUNDOS=60
# Tope de tokens de salida por respuesta
MAX_TOKENS=8192
# Tope de tokens SUMADOS de todas las llamadas de una foto (reintentos y agente). 0 = sin tope
MAX_TOKENS_ACUMULADOS=50000
# Máximo de llamadas a Gemini por lectura; la última va sin herramientas. 1 = sin herramientas (una sola llamada)
MAX_ITERACIONES=4

# ---------- Solo para la evaluación (python -m eval.run) ----------
# Precio en USD por millón de tokens de tu modelo. Vacíos = el costo sale "sin medir"
PRECIO_ENTRADA_USD_M=
PRECIO_SALIDA_USD_M=

# ---------- Solo con PROVEEDOR_IA=falso ----------
# ok | vacio | invalido | timeout | cuota | api
# FALSO_ESCENARIO=ok
